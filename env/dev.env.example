# MongoDB Configuration (Local Docker Instance)
MONGO_DB_ATLAS_CONNECTION_STRING=mongodb://admin_root:admin_root@localhost:27017/blocomanager?authSource=admin

# Admin Configuration
ADMIN_EMAIL=your_admin_email@example.com

# VPN Configuration - Comma-separated list of allowed IPs for admin/swagger access
# Example: VPN_ALLOWED_IPS=10.0.0.5,10.0.0.10
# Leave empty for development (allows all IPs)
VPN_ALLOWED_IPS=

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=100000000000000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_API_URL=
STRIPE_PAYMENT_SUCCESS_WEBHOOK_SECRET_KEY=whsec_your_payment_success_webhook_secret

# Nylas Configuration
NYLAS_MAIN_ACCOUNT_EMAIL=your_email@example.com
NYLAS_CLIENT_ID=your_nylas_client_id
NYLAS_CLIENT_SECRET=your_nylas_client_secret
NYLAS_MAIN_ACCOUNT_ACCESS_TOKEN=your_nylas_access_token

# Vonage Configuration
VONAGE_API_BASE_URL=
VONAGE_JWT_365_DAYS=your_vonage_jwt

# Webhook URLs
CREATE_MEETING_URL=https://hook.us2.make.com/your_webhook_url

# Google OAuth Configuration for Tenant Admin Panel
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.blocomanager.com/api/admin/auth/google/callback

# Google OAuth Configuration for Email Notifications (Gmail API)
GOOGLE_EMAIL_CLIENT_ID=your_google_email_client_id
GOOGLE_EMAIL_CLIENT_SECRET=your_google_email_client_secret
GOOGLE_EMAIL_PROJECT_ID=your_google_project_id
GOOGLE_EMAIL_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_EMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_EMAIL_REDIRECT_URI=http://localhost:3002/auth/google/callback
GOOGLE_EMAIL_REFRESH_TOKEN=your_refresh_token_here  # Generate using: node scripts/generate-gmail-token.js

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Application Configuration
NODE_ENV=development
PORT=3002
