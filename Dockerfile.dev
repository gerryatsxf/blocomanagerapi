FROM node:20-alpine

# Install Python and build tools for native dependencies (minimal set)
RUN apk add --no-cache python3 make g++ \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install all dependencies (needed for building)
RUN npm ci --no-audit --prefer-offline \
    && npm cache clean --force \
    && rm -rf ~/.npm

# Copy source code
COPY . .

# Build the application and check output
RUN NODE_OPTIONS="--max-old-space-size=512" npm run build && \
    echo "Build completed. Checking dist directory:" && \
    ls -la dist/ && \
    echo "Contents of dist/main*:" && \
    ls -la dist/main*

# Set environment variables with memory limits
ENV NODE_ENV=development
ENV PORT=3002
ENV NODE_OPTIONS="--max-old-space-size=256"

# Expose port
EXPOSE 3002

# Start the application in production mode (no watch mode)
CMD ["node", "dist/main.js"]
