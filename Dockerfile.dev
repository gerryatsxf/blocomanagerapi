FROM node:20-alpine

# Install Python and build tools for native dependencies (minimal set)
RUN apk add --no-cache python3 make g++ \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies with memory optimization
RUN npm ci --only=production --no-audit --prefer-offline \
    && npm cache clean --force \
    && rm -rf ~/.npm

# Install only necessary dev dependencies for development
RUN npm install --only=dev --no-audit --prefer-offline \
    && npm cache clean --force

# Copy source code
COPY . .

# Set environment variables with memory limits
ENV NODE_ENV=development
ENV PORT=3002
ENV NODE_OPTIONS="--max-old-space-size=256"

# Expose port
EXPOSE 3002

# Start the application in development mode with hot reload
CMD ["npm", "run", "start:dev"]
