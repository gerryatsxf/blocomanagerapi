{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug NestJS Application",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
            "args": [
                "start",
                "--debug",
                "--watch"
            ],
            "env": {
                "NODE_ENV": "development"
            },
            "envFile": "${workspaceFolder}/env/dev.env",
            "console": "integratedTerminal",
            "restart": true,
            "runtimeArgs": ["--nolazy"],
            "sourceMaps": true,
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "<node_internals>/**",
                "node_modules/**"
            ],
            "outputCapture": "std"
        },
        {
            "name": "Debug NestJS Tests",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/jest",
            "args": [
                "--runInBand",
                "--no-cache",
                "--watch"
            ],
            "env": {
                "NODE_ENV": "test"
            },
            "envFile": "${workspaceFolder}/env/dev.env",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "<node_internals>/**",
                "node_modules/**"
            ],
            "outputCapture": "std"
        },
        {
            "name": "Debug Current Test File",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/jest",
            "args": [
                "${relativeFile}",
                "--runInBand",
                "--no-cache"
            ],
            "env": {
                "NODE_ENV": "test"
            },
            "envFile": "${workspaceFolder}/env/dev.env",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "<node_internals>/**",
                "node_modules/**"
            ],
            "outputCapture": "std"
        }
    ]
}